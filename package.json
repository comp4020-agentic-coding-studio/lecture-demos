{
  "name": "comp4020-lecture-demos",
  "private": true,
  "scripts": {
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "setup": "mix setup",
    "dev": "mix phx.server",
    "build": "mix release.build",
    "typecheck": "mix compile --warnings-as-errors",
    "check": "pnpm typecheck && pnpm test",
    "test": "mix test && pnpm build && vitest run"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "axe-core": "^4.13.0",
    "jsdom": "^30.1.0",
    "marked": "^18.0.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "pnpm": ">=11"
  }
}
