---
import Layout from "../layouts/Layout.astro";
import PriceTag from "../components/PriceTag.astro";
import DiscountSticker from "../components/DiscountSticker.astro";
import { getDeal } from "../data/products";
import { relativeHref, ROUTES } from "../lib/site";

const path = Astro.url.pathname;
const pretzel = getDeal("43666515");
const airFryer = getDeal("43624515");
---

<Layout
  title="Home"
  description="MARKDOWN reimagines Kmart Australia's Clearance range around markdown strength, not just final price — an independent student redesign concept."
>
  <section class="hero section">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">An independent redesign concept</p>
        <h1>Kmart Clearance, rethought.</h1>
        <p class="lede">
          A low final price tells you what you spend.<br />
          A big markdown tells you what changed.
        </p>
        <a class="btn btn-primary" href={relativeHref(path, ROUTES.dealExplorer)}>
          Explore the deals <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="hero-compare" aria-label="Two grounded Kmart Clearance examples, compared">
        <div class="hero-item">
          <DiscountSticker percentage={pretzel.discountPercentage} size="lg" />
          <p class="hero-item-name">{pretzel.name}</p>
          <PriceTag
            originalPrice={pretzel.originalPrice}
            clearancePrice={pretzel.clearancePrice}
            savingAmount={pretzel.savingAmount}
            size="lg"
          />
        </div>

        <div class="hero-vs" aria-hidden="true">vs</div>

        <div class="hero-item">
          <DiscountSticker percentage={airFryer.discountPercentage} size="lg" />
          <p class="hero-item-name">{airFryer.name}</p>
          <PriceTag
            originalPrice={airFryer.originalPrice}
            clearancePrice={airFryer.clearancePrice}
            savingAmount={airFryer.savingAmount}
            size="lg"
          />
        </div>
      </div>

      <p class="hero-caption">
        The Pretzel Ceramic Pen Cup is Kmart's own biggest <strong>percentage</strong> markdown in this
        sample. The Air Fryer and Pizza Maker is Kmart's own biggest <strong>dollar</strong> markdown.
        Sorted by price alone, neither stands out from the other 10,000 products in Clearance.
      </p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container about-grid">
      <div>
        <h2>Why I chose Kmart</h2>
        <p>
          Kmart's product range is broad, but what stands out during Clearance are the
          occasional, unusually deep markdowns — deals memorable enough to be worth a special
          trip. Scanning Kmart's own Clearance pages for those deals by eye, across ten thousand
          products, is slow going.
        </p>
      </div>
      <div>
        <h2>The problem, confirmed</h2>
        <p>
          A direct browser screenshot of Kmart's live Clearance range shows
          <strong>"1–60 of 10000 Products"</strong>, sortable only by <strong>Price: Low to high</strong>,
          <strong>Price: High to low</strong>, <strong>New</strong>, or <strong>Relevance</strong>. There
          is no way to sort by how much an item has been marked down.
        </p>
      </div>
      <div>
        <h2>The redesign idea</h2>
        <p>
          MARKDOWN adds two sort modes Kmart doesn't offer: <strong>Biggest discount</strong> (ranked by
          percentage off) and <strong>Biggest saving</strong> (ranked by dollars off) — see
          <a href={relativeHref(path, ROUTES.whyThisRedesign)}>why this redesign</a> for the reasoning, or jump
          straight into the <a href={relativeHref(path, ROUTES.dealExplorer)}>Deal Explorer</a>.
        </p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero-grid {
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
  }

  @media (width >= 900px) {
    .hero-grid {
      grid-template-columns: 1.1fr 1fr;
      align-items: center;
    }

    .hero-caption {
      grid-column: 1 / -1;
    }
  }

  .hero-copy h1 {
    font-size: clamp(2.4rem, 6vw, 3.6rem);
    max-width: 18ch;
  }

  .hero-compare {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: clamp(1.25rem, 3vw, 2rem);
    box-shadow: var(--shadow);
  }

  .hero-item {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    min-width: 0;
  }

  .hero-item-name {
    margin: 0;
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--ink-soft);
  }

  .hero-vs {
    font-weight: 900;
    font-size: 0.85rem;
    text-transform: uppercase;
    color: var(--ink-soft);
    flex-shrink: 0;
  }

  .hero-caption {
    margin-top: 1.75rem;
    color: var(--ink-soft);
    max-width: 56rem;
  }

  .about-grid {
    display: grid;
    gap: 2rem;
  }

  @media (width >= 800px) {
    .about-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .about-grid h2 {
    font-size: 1.15rem;
  }

  @media (width < 480px) {
    .hero-compare {
      flex-direction: column;
    }

    .hero-vs {
      align-self: center;
    }
  }
</style>
