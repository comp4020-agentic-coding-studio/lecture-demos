---
import Layout from "../layouts/Layout.astro";
import ProductCard from "../components/ProductCard.astro";
import { dealProducts } from "../data/products";
import { SORT_MODES, SORT_LABELS, departmentSlug } from "../lib/deals";

const departments = [
  ...new Set(dealProducts.map((d) => d.department)),
].sort((a, b) => a.localeCompare(b));
---

<Layout
  title="Deal Explorer"
  description="Sort Kmart Australia's grounded Clearance sample by biggest discount or biggest saving, not just price."
>
  <section class="section-tight">
    <div class="container">
      <p class="eyebrow">11 grounded Clearance products</p>
      <h1>Deal Explorer</h1>
      <p class="lede">
        Sort this sample the way Kmart's own Clearance range can't: by how much has actually
        changed, not just what it costs now.
      </p>

      <form class="controls" aria-label="Sort and filter deals">
        <div class="control">
          <label for="sort-select">Sort by</label>
          <select id="sort-select" name="sort">
            {
              SORT_MODES.map((mode) => (
                <option value={mode} selected={mode === "featured"}>
                  {SORT_LABELS[mode]}
                </option>
              ))
            }
          </select>
        </div>

        <div class="control">
          <label for="department-select">Category</label>
          <select id="department-select" name="department">
            <option value="all" selected>All categories</option>
            {
              departments.map((department) => (
                <option value={departmentSlug(department)}>{department}</option>
              ))
            }
          </select>
        </div>
      </form>

      <p id="deal-status" class="deal-status" aria-live="polite">
        Showing {dealProducts.length} of {dealProducts.length} deals, sorted by Featured.
      </p>

      <div class="deal-grid" id="deal-grid">
        {dealProducts.map((deal) => <ProductCard deal={deal} />)}
      </div>
    </div>
  </section>

  <script>
    import { compareBy, SORT_LABELS, type SortMode, type SortableDeal } from "../lib/deals";

    const grid = document.getElementById("deal-grid");
    const sortSelect = document.getElementById("sort-select") as HTMLSelectElement | null;
    const departmentSelect = document.getElementById("department-select") as HTMLSelectElement | null;
    const status = document.getElementById("deal-status");

    function readCard(el: HTMLElement): SortableDeal & { el: HTMLElement; department: string } {
      const data = el.dataset;
      return {
        el,
        department: data.department ?? "other",
        clearancePrice: Number.parseFloat(data.price ?? "0"),
        discountPercentage: Number.parseFloat(data.discount ?? "0"),
        savingAmount: Number.parseFloat(data.saving ?? "0"),
        sourceOrder: Number.parseInt(data.order ?? "0", 10),
        name: data.name ?? "",
      };
    }

    function applyState(): void {
      if (!grid || !sortSelect || !departmentSelect || !status) return;

      const mode = sortSelect.value as SortMode;
      const department = departmentSelect.value;
      const compare = compareBy(mode);

      const cards = Array.from(grid.querySelectorAll<HTMLElement>("[data-deal]")).map(readCard);
      cards.sort(compare);

      let visible = 0;
      for (const card of cards) {
        grid.appendChild(card.el);
        const matches = department === "all" || card.department === department;
        card.el.hidden = !matches;
        if (matches) visible += 1;
      }

      status.textContent = `Showing ${visible} of ${cards.length} deals, sorted by ${SORT_LABELS[mode]}.`;
    }

    sortSelect?.addEventListener("change", applyState);
    departmentSelect?.addEventListener("change", applyState);
  </script>

  <style>
    .controls {
      display: flex;
      flex-wrap: wrap;
      gap: 1.5rem;
      margin: 1.75rem 0 1rem;
    }

    .control {
      min-width: 12rem;
    }

    .control select {
      width: 100%;
    }

    .deal-status {
      font-weight: 700;
      color: var(--ink-soft);
      margin-bottom: 1.5rem;
    }

    .deal-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(15.5rem, 1fr));
      gap: 1.25rem;
    }

    .deal-grid [hidden] {
      display: none;
    }
  </style>
</Layout>
