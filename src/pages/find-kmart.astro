---
import Layout from "../layouts/Layout.astro";

const links = [
  {
    label: "Official Kmart Australia website",
    href: "https://www.kmart.com.au/",
    note: "Homepage — navigation, delivery/payment info, and department links, confirmed by direct fetch.",
  },
  {
    label: "Shop All Clearance",
    href: "https://www.kmart.com.au/category/clearance/shop-all-clearance/",
    note: "Kmart's own Clearance hub, linked from the site's main navigation.",
  },
  {
    label: "Store Locator",
    href: "https://www.kmart.com.au/store-locator/",
    note: "Kmart's official store-finder page.",
  },
  {
    label: "Contact Us",
    href: "https://www.kmart.com.au/contact-us/",
    note: "Kmart's official contact/help page.",
  },
];
---

<Layout
  title="Find Kmart"
  description="Official Kmart Australia links: the main site, the Clearance range, the store locator, and contact information."
>
  <section class="section-tight">
    <div class="container">
      <p class="eyebrow">Official links only</p>
      <h1>Find Kmart</h1>
      <p class="lede">
        MARKDOWN is a redesign concept, not a store finder. For anything that needs to be
        current — trading hours, stock, a specific store — use Kmart's own official pages below.
      </p>

      <address class="find-grid">
        {
          links.map((link) => (
            <a class="find-card" href={link.href} target="_blank" rel="noopener">
              <span class="find-card-label">
                {link.label} <span aria-hidden="true">↗</span>
              </span>
              <span class="find-card-note">{link.note}</span>
            </a>
          ))
        }
      </address>

      <div class="facts">
        <h2>What Kmart says about itself</h2>
        <p>
          Kmart's own About Us page states it operates <strong>450 stores</strong>, employs
          <strong>55,000+ people</strong>, and serves <strong>7 million+ weekly customers</strong> —
          reported here as Kmart's own claim, not independently audited.
        </p>
        <p class="facts-note">
          Kmart's Contact Us and Store Locator pages exist and are linked above, but their
          phone number, email address, and opening-hours content is rendered client-side and
          could not be confirmed from a static page fetch — so no phone number, email, or hours
          are listed here. Use the links above directly for that information.
        </p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .find-grid {
    display: grid;
    gap: 1rem;
    margin: 1.75rem 0 2.5rem;
  }

  @media (width >= 700px) {
    .find-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .find-card {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--paper-raised);
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    color: var(--ink);
  }

  .find-card:hover {
    border-color: var(--accent);
  }

  .find-card-label {
    font-weight: 800;
    font-size: 1.05rem;
    color: var(--accent-ink);
  }

  .find-card-note {
    color: var(--ink-soft);
    font-size: 0.9rem;
  }

  .facts {
    border-top: 1px solid var(--line);
    padding-top: 1.75rem;
    max-width: 42rem;
  }

  .facts-note {
    font-size: 0.9rem;
    color: var(--ink-soft);
  }
</style>
