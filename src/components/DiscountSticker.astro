---
import { formatPercentage } from "../lib/format";

interface Props {
  percentage: number;
  size?: "md" | "lg";
}

const { percentage, size = "md" } = Astro.props;
---

<div class:list={["sticker", size === "lg" && "sticker-lg"]} aria-hidden="true">
  <span class="sticker-value">{formatPercentage(percentage)}</span>
  <span class="sticker-label">OFF</span>
</div>

<style>
  .sticker {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: var(--accent);
    color: var(--ink);
    border-radius: 50%;
    width: 4.4rem;
    height: 4.4rem;
    transform: rotate(-8deg);
    box-shadow: var(--shadow-sm);
    border: 2px dashed color-mix(in srgb, var(--ink) 35%, transparent);
    flex-shrink: 0;
  }

  .sticker-value {
    font-weight: 900;
    font-size: 1.1rem;
    line-height: 1;
  }

  .sticker-label {
    font-size: 0.55rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .sticker-lg {
    width: 7.5rem;
    height: 7.5rem;
  }

  .sticker-lg .sticker-value {
    font-size: 1.9rem;
  }

  .sticker-lg .sticker-label {
    font-size: 0.75rem;
  }
</style>
