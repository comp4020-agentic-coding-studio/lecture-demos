---
import { splitPrice, formatPrice } from "../lib/format";

interface Props {
  originalPrice: number;
  clearancePrice: number;
  savingAmount: number;
  size?: "md" | "lg";
}

const { originalPrice, clearancePrice, savingAmount, size = "md" } = Astro.props;
const now = splitPrice(clearancePrice);
---

<div class:list={["price-tag", size === "lg" && "price-tag-lg"]}>
  <p class="price-tag-was">
    Was <span>{formatPrice(originalPrice)}</span>
  </p>
  <p class="price-tag-now">
    <span class="price-tag-now-label">Now</span>
    <span class="price-tag-now-value"
      >{now.whole}<span class="price-tag-now-cents">{now.cents}</span></span
    >
  </p>
  <p class="price-tag-save">Save {formatPrice(savingAmount)}</p>
</div>

<style>
  .price-tag {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .price-tag-was {
    margin: 0;
    font-size: 0.9rem;
    color: var(--ink-soft);
  }

  .price-tag-was span {
    text-decoration: line-through;
    text-decoration-color: var(--ink-soft);
    text-decoration-thickness: 0.12em;
  }

  .price-tag-now {
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
  }

  .price-tag-now-label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-soft);
  }

  .price-tag-now-value {
    font-size: clamp(1.8rem, 4vw, 2.4rem);
    font-weight: 900;
    letter-spacing: -0.02em;
    color: var(--ink);
    line-height: 1;
  }

  .price-tag-now-cents {
    font-size: 0.55em;
    font-weight: 800;
    vertical-align: super;
  }

  .price-tag-save {
    margin: 0;
    display: inline-flex;
    align-self: flex-start;
    background: var(--save-soft);
    color: var(--save);
    font-weight: 800;
    font-size: 0.85rem;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
  }

  .price-tag-lg .price-tag-now-value {
    font-size: clamp(2.6rem, 7vw, 4rem);
  }

  .price-tag-lg .price-tag-save {
    font-size: 1rem;
  }
</style>
