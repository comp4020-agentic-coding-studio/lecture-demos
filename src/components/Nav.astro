---
import { relativeHref, siteBase, ROUTES, type Route } from "../lib/site";

const base = siteBase();
const path = Astro.url.pathname;

const links = [
  { route: ROUTES.home, label: "Home" },
  { route: ROUTES.dealExplorer, label: "Deal Explorer" },
  { route: ROUTES.whyThisRedesign, label: "Why this redesign" },
  { route: ROUTES.findKmart, label: "Find Kmart" },
];

function isActive(route: Route): boolean {
  const absolute = `${base}${route}`;
  if (route === ROUTES.home) return path === absolute || path === `${absolute}index.html`;
  return path.startsWith(absolute);
}
---

<nav class="primary-nav" id="primary-nav" aria-label="Primary">
  <button
    class="nav-toggle"
    id="nav-toggle"
    type="button"
    aria-expanded="false"
    aria-controls="primary-nav-menu"
  >
    <span class="nav-toggle-bars" aria-hidden="true"></span>
    Menu
  </button>
  <ul id="primary-nav-menu">
    {
      links.map((link) => (
        <li>
          <a href={relativeHref(path, link.route)} aria-current={isActive(link.route) ? "page" : undefined}>
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<script>
  const nav = document.getElementById("primary-nav");
  const toggle = document.getElementById("nav-toggle");

  if (nav && toggle) {
    // Collapse the menu only now that the script which can reopen it is running.
    nav.dataset.collapsible = "";

    const setExpanded = (expanded: boolean) =>
      toggle.setAttribute("aria-expanded", String(expanded));

    toggle.addEventListener("click", () => {
      setExpanded(toggle.getAttribute("aria-expanded") !== "true");
    });

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || toggle.getAttribute("aria-expanded") !== "true") return;
      setExpanded(false);
      toggle.focus();
    });
  }
</script>
