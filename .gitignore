node_modules/
*.log

# Elixir build output, fetched deps, and the assets the build writes
/_build/
/deps/
/priv/static/assets/
/priv/static/cache_manifest.json
/priv/static/*-*.*
/priv/static/*.gz
erl_crash.dump

# editor and OS junk
.DS_Store
._*
Thumbs.db
Desktop.ini

# the local dev database — state on your machine, never in the repo
.data/
*.db
*.db-*

# keep secrets out of the repo: your API key lives in an env var or an
# untracked file, never in a tracked one
.env
.env.*
.envrc
mise.local.toml
*.pem

# Claude Code's project directory is machine-local: settings in here can hold
# your course API key, and this repo goes public when you ship. Your tracked
# harness is CLAUDE.md (and any AGENTS.md), not this directory.
.claude/
